%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Developer CV - Page layout
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ProvidesPackage{developercv-layout}[2023/10/12 Developer CV page layout]

\RequirePackage{geometry} % Required for adjusting page dimensions and margins

\geometry{
    paper=a4paper, % Paper size, change to letterpaper for US letter size
    top=1cm, % Top margin
    bottom=1cm, % Bottom margin
    left=1cm, % Left margin
    right=1cm, % Right margin
    headheight=0.75cm, % Header height
    footskip=0.75cm, % Space from the bottom margin to the baseline of the footer
    headsep=0.5cm, % Space from the top margin to the baseline of the header
    %showframe, % Uncomment to show how the type block is set on the page
}
